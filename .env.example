# Server Configuration
PORT=4981
LOG_LEVEL=info
APP_ENV=development
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Gemini Configuration
# Visit https://gemini.google.com and log in, then open Developer Tools (F12)
# -> Application/Storage -> Cookies and copy the full Gemini/Google auth cookie set.
GEMINI_COOKIES="APISID=...; SAPISID=...; __Secure-1PSID=...; __Secure-1PSIDCC=..."
GEMINI_MAX_RETRIES=3
